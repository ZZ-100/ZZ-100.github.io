.nav-wrap
    .nav
        button.site-nav(type='button' aria-label='Open quick navigation' aria-expanded='false' aria-controls='quick-nav')
            .navicon
        ul#quick-nav.nav_items
            each value, label in theme.menu
                if !Array.isArray(value)
                    li.nav_item
                        a.nav-page(href=url_for(trim(value.split('||')[0])))=' ' + label
                else
                    li.nav_item
                        a.nav-page=' ' + trim(label.split('||')[0])
    button.cd-top(type='button' aria-label='Back to top')
        i(class="fa fa-arrow-up" aria-hidden="true")
