extends includes/layout

block content
    .page(itemscope itemtype='http://schema.org/CreativeWork')
        h2.page-title!= page.title
        article!= page.content
        if(theme.contact_items)
            h2.page-contact Contact
            ul.contact-list
                each value, name in theme.contact_items
                    - var parts = value.split('||')
                    - var url = trim(parts[0])
                    - var icon = trim(parts[1])
                    - var label = parts.length > 2 && trim(parts[2]) ? trim(parts[2]) : url.replace(/^mailto:/, '').replace(/^https?:\/\//, '').replace(/\/$/, '')
                    li
                        i(class=icon aria-hidden="true")
                        span
                            != name + ': '
                            a(href=url_for(url) target="_blank")!= label