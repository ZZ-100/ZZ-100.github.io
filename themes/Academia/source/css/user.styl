// 页面排版：复现 Word 文档编辑规范
// 标题黑体、正文宋体、1.5 倍行距、正文首行缩进、列表紧凑无符号
.page
    h2.page-title
        text-align: center
        font-family: "黑体", "SimHei", "Microsoft YaHei", sans-serif
        font-size: 20px
        font-weight: bold

    article
        font-family: "宋体", "SimSun", "NSimSun", serif
        font-size: 16px
        line-height: 1.5
        color: #333

        h1, h2, h3, h4
            font-family: "黑体", "SimHei", "Microsoft YaHei", sans-serif
            font-weight: bold

        h1
            text-align: center
            font-size: 20px

        h2
            font-size: 19px
            margin: 12px 0 6px

        h3
            font-size: 17px
            margin: 10px 0 5px

        p
            text-indent: 2em
            margin: 0.4em 0

        ul
            list-style: none
            padding-left: 0

        li
            margin: 0.2em 0